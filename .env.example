# Copy to .env locally. Never commit .env. In the cluster these come from a Kubernetes Secret created by hand.

# App
NODE_ENV=development
API_PORT=3000                 # cluster sets PORT=8080, which wins
STORE=                        # elastic | memory. Empty = elastic if ELASTIC_URL is set, else memory (dev only)
WORKER_URL=                   # empty = run the pipeline inside the api process
WEB_URL=http://localhost:5173
CHAOS_MODE=false
SEED=false
VENUE_TZ=America/Denver

# Elasticsearch (Elastic Cloud)
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX_RAW=context_raw
ELASTIC_INDEX_ITEMS=context_items
ELASTIC_INDEX_TASKS=context_tasks
ELASTIC_SERVER_MODE=           # serverless | stack. Set to serverless for an Elastic Cloud Serverless project
ELASTIC_INFERENCE_ID=          # empty = the cluster's default semantic_text endpoint

# Transcription + librarian (OpenAI, hackathon credits)
OPENAI_API_KEY=
TRANSCRIBER=openai            # openai | local
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_BASE_URL=               # empty = https://api.openai.com/v1
LIBRARIAN=on                  # on | off. On = extract decisions/todos/questions after each capture (needs OPENAI_API_KEY)
LIBRARIAN_MODEL=              # empty = gpt-5.4-mini

# GitHub poller → ingest (board posts, PRs, Gitar reviews). Polls the REST API; no webhook needed
GITHUB_WEBHOOK_SECRET=
GITHUB_REPO=owner/hack-harness   # owner/name to poll. The placeholder (or empty) = poller off
GITHUB_POLL=                  # off = disable the poller even when GITHUB_REPO is set
GITHUB_TEAM_ID=hh             # team_id the GitHub activity is filed under
GITHUB_BOARD_ISSUE=2          # issue number of the pinned Board; its comments ingest as type=board
GITHUB_POLL_SECONDS=45        # poll interval (min 5)
GITHUB_TOKEN=                 # optional, read-only. Raises the rate limit from 60/h to 5000/h

# OpenTelemetry → Dash0 (OTLP/HTTP: traces, metrics, logs). Empty endpoint = telemetry off.
# Dash0 form (region from Dash0 → Settings → Endpoints; HTTPS on 443, the SDK appends /v1/traces etc.):
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://ingress.<region>.aws.dash0.com
#   OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20<auth token>,Dash0-Dataset=default
# Local check: any OTLP collector, e.g. http://localhost:4318
OTEL_SERVICE_NAME=hack-harness-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
